# Copy this file to .env and fill in your keys. Docker Compose reads .env automatically.
ENTERPRISE_AGENTGATEWAY_LICENSE_KEY=<license-key>
OPENAI_API_KEY=<openai-api-key>
# Optional. Leave empty to skip the Anthropic steps.
ANTHROPIC_API_KEY=
# Optional. AWS credentials for the Amazon Bedrock lab. Leave empty to skip it.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials, for example from AWS SSO.
AWS_SESSION_TOKEN=
# Optional. An Amazon Bedrock API key, for the API key step of the Bedrock lab.
BEDROCK_API_KEY=
# Optional. A TypeSafe API key for the Jev labs (semantic-routing-jev, webhook-guardrails-jev). Leave empty to skip them.
TYPESAFE_AI_API_KEY=
